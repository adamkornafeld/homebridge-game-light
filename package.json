    "url": "git+https://github.com/adamkornafeld/homebridge-game-light.git"
  },
  "bugs": {
    "url": "https://github.com/adamkornafeld/homebridge-game-light/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/adamkornafeld"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "nba",
    "basketball",
    "sports",
    "game",
    "automation",
    "smart-home",
    "homekit"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.8 || ^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
